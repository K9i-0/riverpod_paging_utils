{
  "mcpServers": {
    "dart-mcp": {
      "type": "stdio",
      "command": "dart",
      "args": [
        "mcp-server",
        "--enable",
        "flutter_app_lifecycle"
      ]
    },
    "marionette": {
      "type": "stdio",
      "command": "marionette_mcp",
      "args": []
    },
    "patrol": {
      "type": "stdio",
      "command": "sh",
      "args": [
        "tool/patrol_mcp.sh"
      ]
    }
  }
}
